{{velocity}}
#if($services.security.authorization.hasAccess('admin', $services.model.resolveDocument('XWiki.XWikiPreferences')))
{{html clean="false"}}
<section id="luxpedia-rag-sync">
<h2 data-luxpedia-i18n="ragSync"></h2>
<p data-luxpedia-i18n="ragSyncIntro"></p>
<p role="status" id="luxpedia-rag-notice"></p>
<div id="luxpedia-rag-content"></div>
</section>
{{/html}}
#else
$services.localization.render('luxpedia.adminOnly')
#end
{{/velocity}}
