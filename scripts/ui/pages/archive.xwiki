#set($articles = $services.query.xwql("from doc.object(PublicationWorkflow.PublicationWorkflowClass) as wf where wf.istarget = 1 and (doc.space = 'Knowledge' or doc.space like 'Knowledge.%') and (wf.status = 'archived' or doc.space = 'Knowledge.Archive' or doc.space like 'Knowledge.Archive.%') and doc.fullName <> 'Knowledge.Archive.WebHome' and doc.name <> 'WebPreferences' and doc.language = '' order by doc.date desc").addFilter('unique').execute())
#set($visible = false)


{{html clean="false"}}
<p>#lp('archiveListHint')</p>
<table class="table table-striped luxpedia-system-list" style="width:100%;table-layout:fixed;overflow-wrap:anywhere">
<thead><tr><th scope="col">#lp('title')</th><th scope="col">#lp('status')</th><th scope="col">#lp('originalLocation')</th></tr></thead>
<tbody>
#foreach($item in $articles)
#set($article = $xwiki.getDocument($item))
#if($article.hasAccessLevel('view'))
#set($visible = true)
#set($flow = $article.getObject('PublicationWorkflow.PublicationWorkflowClass'))
#set($state = 'published')
#if($flow)#set($state = $flow.getValue('status'))#end
<tr><td><a href="$escapetool.xml($xwiki.getURL($item))">$escapetool.xml($article.displayTitle)</a></td><td>#lp($state)</td><td>$escapetool.xml($item)</td></tr>
#end
#end
#if(!$visible)
<tr><td colspan="3">#lp('archiveEmpty')</td></tr>
#end
</tbody>
</table>
{{/html}}
